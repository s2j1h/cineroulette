# Optionnel : l'API "trial" UPCitemdb (gratuite, ~100 req/jour) fonctionne sans
# clé. Ne renseigner que si tu as souscrit à leur offre PRO payante.
UPCITEMDB_API_KEY=
TMDB_API_KEY=
OMDB_API_KEY=

SECRET_KEY=change-me-in-production
FLASK_DEBUG=0

# Optionnel : chemins vers un certificat TLS local (voir README, section HTTPS local)
# pour servir en HTTPS via `python run.py` (nécessaire pour le scan caméra sur mobile).
SSL_CERT_FILE=
SSL_KEY_FILE=
